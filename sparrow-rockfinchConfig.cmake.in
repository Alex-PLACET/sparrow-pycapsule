# sparrow-rockfinch cmake module
#
#   sparrow-rockfinch_FOUND        - true if sparrow-rockfinch was found
#   sparrow-rockfinch_INCLUDE_DIRS - the directory containing sparrow-rockfinch headers
#   sparrow-rockfinch_LIBRARY      - the sparrow-rockfinch library

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(sparrow)
find_dependency(Python COMPONENTS Interpreter Development.Module)

if(NOT TARGET sparrow::sparrow-rockfinch-cpp)
    include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
    get_target_property(@PROJECT_NAME@_INCLUDE_DIRS sparrow::sparrow-rockfinch-cpp INTERFACE_INCLUDE_DIRECTORIES)
    get_target_property(@PROJECT_NAME@_LIBRARY sparrow::sparrow-rockfinch-cpp LOCATION)
endif()
